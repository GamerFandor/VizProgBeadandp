<Window x:Class="ClassroomGamf.Views.GroupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Csoport beállításai" Height="300" Width="400">
    <StackPanel Margin="20">
        <TextBlock Text="Csoport neve:" Margin="0,0,0,5"/>
        <TextBox x:Name="GroupNameTextBox" Margin="0,0,0,10"/>

        <TextBlock Text="Tagok száma (csak olvasható):" Margin="0,0,0,5"/>
        <TextBlock x:Name="MemberCountLabel" Margin="0,0,0,10"/>

        <Button Content="Mentés" Click="Save_Click" HorizontalAlignment="Right" Width="100"/>
    </StackPanel>
</Window>
