<Page x:Class="ClassroomGamf.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ClassroomGamf.Views"
      Title="HomePage" Background="White">

    <Grid>
        <!-- Navbar -->
        <DockPanel Background="#2C3E50" Height="50" VerticalAlignment="Top">
            <!-- Title -->
            <TextBlock Text="GAMF Classroom"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       DockPanel.Dock="Left" />

            <!-- User Button -->
            <Button Content="👤"
                    Width="20"
                    Height="20"
                    Margin="0,5,10,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="White"
                    Foreground="black"
                    BorderThickness="0"
                    DockPanel.Dock="Right"
                    ToolTip="Felhasználói fiók"
                    Click="UserButton_Click"/>
        </DockPanel>

        <!-- Main content below navbar -->
        <Grid Margin="0,60,0,0" x:Name="MainContentGrid">
            <Button Click="GroupButton_Click">
            <Border BorderBrush="Gray" BorderThickness="1" Width="150" CornerRadius="10" Padding="10" Margin="5" Background="White">
                <StackPanel>
                    <Image Source="/Assets/feed.jpg" Height="100" Stretch="Fill"/>
                    <TextBlock Text="Group 1" FontWeight="Bold" FontSize="16" Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="14"/>
                        <TextBlock Text="25" FontSize="14" Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- Admin Gomb -->
                    <!--<Button Content="Manage" 
                Visibility="{Binding IsAdmin, ElementName=GroupCardControl, Converter={StaticResource BoolToVisibilityConverter}}"
                Margin="0,5,0,0"
                Click="AdminButton_Click"/>-->
                    <Button Content="Manage" 
            Margin="0,5,0,0"
            Click="AdminButton_Click"/>
                </StackPanel>
            </Border>
            </Button>
        </Grid>
    </Grid>
</Page>
