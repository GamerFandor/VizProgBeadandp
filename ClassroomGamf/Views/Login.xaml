<Page x:Class="ClassroomGamf.Views.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Login Page">

    <Grid Background="#f0f0f0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock Text="Bejelentkezés" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBox x:Name="UsernameTextBox" Margin="20,0,20,10"/>
            <PasswordBox x:Name="PasswordBox" Margin="20,0,20,20" />

            <Button Content="Belépés" Click="LoginButton_Click" Height="35" Background="#2196F3" Foreground="White"/>
            <Button Content="Regisztráció" Click="RegisterButton_Click" Margin="0,10,0,0" Height="35" Background="#2196F3" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>
