<UserControl x:Class="ClassroomGamf.Components.GroupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClassroomGamf.Components"
             x:Name="GroupCardControl"
             Height="200" Width="300">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Padding="10" Margin="5" Background="White">
        <StackPanel>
            <Image Source="{Binding ImagePath, ElementName=GroupCardControl}" Height="100" Stretch="Fill"/>
            <TextBlock Text="{Binding Title, ElementName=GroupCardControl}" FontWeight="Bold" FontSize="16" Margin="0,5,0,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="👥" FontSize="14"/>
                <TextBlock Text="{Binding MemberCount, ElementName=GroupCardControl}" FontSize="14" Margin="5,0,0,0"/>
            </StackPanel>

            <!-- Admin Gomb -->
            <!--<Button Content="Manage" 
                    Visibility="{Binding IsAdmin, ElementName=GroupCardControl, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,5,0,0"
                    Click="AdminButton_Click"/>-->
            <Button Content="Manage" 
                Margin="0,5,0,0"
                Click="AdminButton_Click"/>
        </StackPanel>
    </Border>
</UserControl>
